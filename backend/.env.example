# Server Environment Configuration
NODE_ENV=production
PORT=5000

# Database & Security Credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/foodnest?retryWrites=true&w=majority
JWT_SECRET=super_secure_jwt_secret_change_me_in_production

# Frontend Origin & CORS Configurations
FRONTEND_URL=https://your-restaurant-frontend.example.com
RESTAURANT_FRONTEND_URL=https://your-restaurant-frontend.example.com
CUSTOMER_FRONTEND_URL=https://your-customer-frontend.example.com
CORS_ORIGIN=https://your-restaurant-frontend.example.com,https://your-customer-frontend.example.com

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Credentials (Optional)
RAZORPAY_ACCOUNT_ID=your_razorpay_account_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Brevo (Sendinblue) Transactional Email Service (Optional)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME=FoodNest

# OpenStreetMap / Location Services (Optional)
OPENSTREET_API_KEY=your_openstreet_api_key
