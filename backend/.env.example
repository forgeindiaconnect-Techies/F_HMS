NODE_ENV=development
PORT=5000
MONGO_URI=your_mongodb_connection_uri_here
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay API Credentials
RAZORPAY_ACCOUNT_ID=your_razorpay_account_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Brevo (Sendinblue) Email API Configuration
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME=FoodNest

# OpenStreetMap / Location Services API Key
OPENSTREET_API_KEY=your_openstreet_api_key
