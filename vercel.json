{
  "framework": "vite",
  "buildCommand": "cd frontend-customer && npm install --include=dev && npm run build",
  "outputDirectory": "frontend-customer/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-ochre-five-29.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
