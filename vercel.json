{
  "framework": "vite",
  "buildCommand": "cd frontend-customer && npm install && npm run build",
  "outputDirectory": "frontend-customer/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://f-hms-1-a2ig.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
